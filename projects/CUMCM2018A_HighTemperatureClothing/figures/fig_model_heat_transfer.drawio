<mxfile host="app.diagrams.net" modified="2026-07-27T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="heat-model" name="Page-1">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="pde" value="各层控制方程：ρᵢcᵢ ∂Tᵢ/∂t = kᵢ ∂²Tᵢ/∂x²　(i = 1, 2, 3, 4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;fontColor=#0F172A;fontStyle=1;fontSize=17;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="35" width="740" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="environment" value="高温环境&lt;br&gt;&lt;b&gt;Tₑ&lt;/b&gt;&lt;br&gt;75 / 65 / 80°C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=16;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="35" y="220" width="145" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="layer1" value="&lt;b&gt;I 层&lt;/b&gt;&lt;br&gt;d₁ = 0.6 mm&lt;br&gt;ρ₁, c₁, k₁" style="whiteSpace=wrap;html=1;fillColor=#FDE68A;strokeColor=#B45309;fontColor=#78350F;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="235" y="220" width="105" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="layer2" value="&lt;b&gt;II 层&lt;/b&gt;&lt;br&gt;d₂ ∈ [0.6, 25] mm&lt;br&gt;ρ₂, c₂, k₂&lt;br&gt;&lt;br&gt;主要保温层 / 决策变量" style="whiteSpace=wrap;html=1;fillColor=#BFDBFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="340" y="220" width="390" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="layer3" value="&lt;b&gt;III 层&lt;/b&gt;&lt;br&gt;d₃ = 3.6 mm&lt;br&gt;ρ₃, c₃, k₃" style="whiteSpace=wrap;html=1;fillColor=#C4B5FD;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="730" y="220" width="210" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="layer4" value="&lt;b&gt;IV 层（空气层）&lt;/b&gt;&lt;br&gt;d₄ ∈ [0.6, 6.4] mm&lt;br&gt;ρ₄, c₄, k₄&lt;br&gt;&lt;br&gt;等效导热层 / 决策变量" style="whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#134E4A;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="940" y="220" width="245" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="body" value="人体热库&lt;br&gt;&lt;b&gt;T&lt;sub&gt;b&lt;/sub&gt; = 37°C&lt;/b&gt;&lt;br&gt;&lt;br&gt;输出：皮肤外侧温度&lt;br&gt;&lt;b&gt;Tₛ(t)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=16;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1230" y="220" width="145" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="outerBoundary" value="外侧 Robin 边界&lt;br&gt;-k₁Tₓ(0,t) = hₒ[Tₑ - T₁(0,t)]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=14;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="115" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="bodyBoundary" value="人体侧 Robin 边界&lt;br&gt;-k₄Tₓ(L,t) = h&lt;sub&gt;b&lt;/sub&gt;[Tₛ(t) - T&lt;sub&gt;b&lt;/sub&gt;]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#14532D;fontSize=14;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1010" y="115" width="320" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="interfaceCondition" value="三个层间界面均满足：Tᵢ(sᵢ⁻,t) = Tᵢ₊₁(sᵢ⁺,t)，　kᵢTᵢ,ₓ(sᵢ⁻,t) = kᵢ₊₁Tᵢ₊₁,ₓ(sᵢ⁺,t)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#334155;fontSize=14;arcSize=10;" vertex="1" parent="1">
