#import "../lib.typ": academic-table

= 符号说明

#academic-table(
  [主要符号说明],
  (5.2em, 1fr, 7.6em),
  ([符号], [含义], [单位]),
  (
    [$x,t$], [厚度坐标与时间], [m，s],
    [$d_i,s_i,L$], [第 $i$ 层厚度、界面位置与总厚度], [m],
    [$T_i(x,t)$], [第 $i$ 层温度], [$degree"C"$],
    [$rho_i,c_i,k_i$], [密度、比热容与导热系数], [$"kg"/"m"^3$，$"J"/("kg" dot "K")$，$"W"/("m" dot "K")$],
    [$T_e,T_b$], [环境温度与人体深部热库温度], [$degree"C"$],
    [$h_o,h_b$], [外侧与人体侧等效换热系数], [$"W"/("m"^2 dot "K")$],
    [$T_s(t)$], [皮肤外侧边界温度], [$degree"C"$],
    [$C_j$], [第 $j$ 个控制体的单位面积热容量], [$"J"/("m"^2 dot "K")$],
    [$G_(j+1/2)$], [相邻控制体面的导通系数], [$"W"/("m"^2 dot "K")$],
    [$T_max$], [工作区间内最高皮肤温度], [$degree"C"$],
    [$tau_44$], [严格超过 $44 degree"C"$ 的累计时长], [s],
    [$f_1,f_2$], [总厚度目标与面密度破同目标], [mm，$"kg"/"m"^2$],
  ),
  cell-align: (center, left, center),
) <tab-symbols>

除特别说明外，下文传热计算均采用 SI 单位，厚度设计结果为便于制造以 mm 给出。
